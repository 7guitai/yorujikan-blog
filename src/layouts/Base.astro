---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
  toc?: MarkdownHeading[];
}

const { title, description, toc = [] } = Astro.props;
const siteName = 'よるじかん｜電源オフの暮らしと快眠道具';
const pageTitle = title === siteName ? title : `${title}｜${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/ogp.png', Astro.site);

// グローバルナビ用: 記事数の多いタグ上位4件
const navPosts = await getCollection('blog', ({ data }) => !data.draft);
const navTagCounts = new Map<string, number>();
for (const post of navPosts) {
  for (const tag of post.data.tags) {
    navTagCounts.set(tag, (navTagCounts.get(tag) ?? 0) + 1);
  }
}
const navTags = [...navTagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'))
  .slice(0, 4)
  .map(([tag]) => tag);

const hasBreadcrumb = await Astro.slots.has('breadcrumb');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <style is:global>
      /* =========================================================
         よるじかん - テンプレートのデザイントークンを移植
         ========================================================= */
      :root {
        --main: #2f6f5e;
        --main-light: #e9f3ef;
        --accent: #e8833a;
        --text: #333;
        --text-sub: #777;
        --bg: #f7f7f5;
        --white: #fff;
        --border: #e3e3e0;
        --radius: 6px;
        --container: 1200px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 20px; }
      body {
        margin: 0;
        font-family: "Noto Sans JP", "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.8;
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
      }
      a { color: var(--main); text-decoration: none; }
      a:hover { opacity: .8; }
      img { max-width: 100%; height: auto; vertical-align: bottom; }
      ul, ol { padding-left: 1.5em; }
      button { font: inherit; cursor: pointer; }
      ::selection { background: var(--main-light); }

      .l-container { max-width: var(--container); margin: 0 auto; padding: 0 16px; }

      /* ---------- Header ---------- */
      .l-header {
        background: var(--white);
        border-top: 4px solid var(--main);
        box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        position: relative;
        z-index: 50;
      }
      .l-header__inner {
        display: flex; align-items: center; justify-content: center;
        height: 84px; position: relative;
      }
      .site-logo { font-size: 26px; font-weight: 700; color: var(--text); text-align: center; line-height: 1.3; }
      .site-logo:hover { opacity: 1; color: var(--main); }
      .site-logo small {
        display: block; font-size: 11px; font-weight: 400;
        color: var(--text-sub); letter-spacing: .05em;
      }
      .menu-btn, .search-btn {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: none; border: none; color: var(--text); display: none; padding: 8px;
      }
      .menu-btn { left: 8px; width: 40px; height: 40px; flex-direction: column; justify-content: center; gap: 5px; }
      .menu-btn span { display: block; height: 2px; background: currentColor; width: 22px; margin: 0 auto; transition: .3s; }
      .search-btn { right: 8px; }

      .g-nav { border-top: 1px solid var(--border); }
      .g-nav__list { display: flex; justify-content: center; flex-wrap: wrap; list-style: none; margin: 0 auto; padding: 0; }
      .g-nav__list a {
        display: block; padding: 12px 20px; color: var(--text);
        font-size: 14px; font-weight: 500; position: relative;
      }
      .g-nav__list a::after {
        content: ""; position: absolute; left: 50%; bottom: 6px; width: 0; height: 2px;
        background: var(--main); transition: .25s; transform: translateX(-50%);
      }
      .g-nav__list a:hover { opacity: 1; }
      .g-nav__list a:hover::after { width: 60%; }
      .overlay { display: none; }

      /* ---------- Breadcrumb ---------- */
      .breadcrumb ol {
        list-style: none; display: flex; flex-wrap: wrap;
        margin: 0 auto; padding-top: 14px; padding-bottom: 4px;
        font-size: 12px; color: var(--text-sub);
      }
      .breadcrumb li:not(:last-child)::after { content: "›"; margin: 0 .6em; }
      .breadcrumb a { color: var(--text-sub); }

      /* ---------- Layout ---------- */
      .l-content {
        display: grid; grid-template-columns: minmax(0, 1fr) 300px;
        gap: 40px; padding-top: 16px; padding-bottom: 60px;
      }
      .l-main { min-width: 0; }

      /* ---------- Post head ---------- */
      .post { background: var(--white); border-radius: var(--radius); padding: 40px 48px; }
      .post-title { font-size: 26px; line-height: 1.5; margin: 0 0 16px; }
      .post-meta {
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        margin-bottom: 20px; font-size: 13px; color: var(--text-sub);
      }
      .cat-label {
        background: var(--main); color: #fff; padding: 2px 12px;
        border-radius: 3px; font-size: 12px;
      }
      a.cat-label:hover { opacity: .85; color: #fff; }
      .date { display: inline-flex; align-items: center; gap: 4px; }
      .eyecatch { margin-bottom: 32px; }
      .eyecatch img { width: 100%; border-radius: var(--radius); display: block; }

      /* ---------- Post content ---------- */
      .post-content > * { margin-top: 0; margin-bottom: 1.8em; }
      .post-content p { margin-top: 0; }
      .post-content h2 {
        font-size: 22px; line-height: 1.5; background: var(--main); color: #fff;
        padding: 14px 20px; border-radius: 4px; margin: 2.6em 0 1.2em; position: relative;
      }
      .post-content h2::before {
        content: ""; position: absolute; left: 24px; bottom: -10px;
        border: 10px solid transparent; border-top-color: var(--main); border-bottom: 0;
      }
      .post-content h3 {
        font-size: 19px; line-height: 1.5; padding: 4px 0 8px 16px;
        border-left: 5px solid var(--main); border-bottom: 1px solid var(--border);
        margin: 2.2em 0 1em;
      }
      .post-content h4 { font-size: 17px; margin: 1.8em 0 .8em; }
      .post-content h4::before { content: "■"; color: var(--main); margin-right: .4em; }
      .post-content .marker, .marker {
        background: linear-gradient(transparent 60%, #ffe3a3 60%); font-weight: 700;
      }
      .post-content .caption, .caption { font-size: 12px; color: var(--text-sub); margin-top: -1.2em !important; }
      .post-content img { border-radius: var(--radius); }
      .post-content blockquote {
        margin: 0 0 1.8em; padding: 14px 18px;
        background: #f4f4f2; border-left: 5px solid var(--main);
        border-radius: 0 var(--radius) var(--radius) 0; color: #555;
      }
      .post-content blockquote p:last-child { margin-bottom: 0; }
      .post-content code {
        background: #f0f0ee; border-radius: 4px; padding: .1em .4em; font-size: .9em;
      }
      .post-content hr { border: none; border-top: 1px solid var(--border); }

      .pr-note {
        font-size: 13px; background: #f4f4f2; border: 1px solid var(--border);
        border-radius: var(--radius); padding: 12px 16px; color: #555;
      }

      /* ---------- TOC ---------- */
      .toc { border: 2px solid var(--main); border-radius: var(--radius); padding: 0; overflow: hidden; }
      .toc__head {
        display: flex; justify-content: space-between; align-items: center;
        background: var(--main-light); padding: 10px 16px; font-weight: 700;
      }
      .toc__head span::before { content: "☰"; margin-right: .5em; color: var(--main); }
      .toc__toggle {
        background: var(--white); border: 1px solid var(--border);
        border-radius: 20px; font-size: 12px; padding: 2px 12px;
      }
      .toc__list { margin: 0; padding: 16px 20px 16px 40px; }
      .toc__list li { margin: .3em 0; }
      .toc__list ol { padding-left: 1.4em; list-style: none; }
      .toc__list ol li::before { content: "– "; color: var(--text-sub); }
      .toc__list a { color: var(--text); }
      .toc__list > li > a { font-weight: 500; }
      .toc.is-closed .toc__list { display: none; }

      /* ---------- Boxes ---------- */
      .box { border-radius: var(--radius); padding: 20px 22px; position: relative; }
      .box > *:last-child { margin-bottom: 0; }
      .box__title { font-weight: 700; margin-bottom: 12px; }
      .box__label { display: block; font-weight: 700; margin-bottom: 4px; }
      .box--point { border: 2px solid var(--main); background: #fff; }
      .box--point .box__title { color: var(--main); }
      .box--info { background: #eef5fb; border-left: 5px solid #4a8fc9; }
      .box--alert { background: #fdf1f0; border-left: 5px solid #d9534f; }
      .box--check { background: #fff8ec; border: 1px dashed var(--accent); }

      .merit-demerit { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .merit, .demerit { border-radius: 4px; padding: 12px 14px; }
      .merit { background: #eef7f1; }
      .demerit { background: #fbefef; }
      .md-head { font-weight: 700; margin: 0 0 6px !important; }
      .merit .md-head { color: #2e8b57; }
      .demerit .md-head { color: #c0392b; }
      .merit ul, .demerit ul { margin: 0; }

      .list-check, .list-x { list-style: none; padding-left: 0; }
      .list-check li, .list-x li { padding-left: 1.6em; position: relative; margin: .3em 0; }
      .list-check li::before { content: "✓"; position: absolute; left: 0; color: #2e8b57; font-weight: 700; }
      .list-x li::before { content: "✕"; position: absolute; left: 0; color: #c0392b; font-weight: 700; }
      .list-num { margin: 0; padding-left: 1.4em; }
      .list-num li { margin: .4em 0; }

      /* ---------- Balloon ---------- */
      .balloon { display: flex; gap: 16px; align-items: flex-start; }
      .balloon__icon { flex-shrink: 0; text-align: center; font-size: 11px; color: var(--text-sub); width: 64px; }
      .avatar {
        width: 64px; height: 64px; border-radius: 50%; background: var(--main-light);
        border: 2px solid var(--border); display: flex; align-items: center; justify-content: center;
        font-size: 28px; margin: 0 auto 2px; color: var(--main);
      }
      .avatar--lg { width: 88px; height: 88px; font-size: 38px; }
      .balloon__text {
        position: relative; background: var(--white); border: 2px solid var(--border);
        border-radius: 10px; padding: 14px 18px; margin-top: 6px;
      }
      .balloon__text::before, .balloon__text::after {
        content: ""; position: absolute; top: 18px; border: 9px solid transparent;
      }
      .balloon__text::before { left: -19px; border-right-color: var(--border); }
      .balloon__text::after { left: -15px; border-right-color: var(--white); }

      /* ---------- Table（Markdown表は .compare 風に） ---------- */
      .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .compare { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 14px; line-height: 1.6; }
      .compare th, .compare td { border: 1px solid var(--border); padding: 10px 12px; text-align: center; }
      .compare thead th { background: #555; color: #fff; }
      .compare tbody th { background: #f4f4f2; text-align: left; white-space: nowrap; }
      .compare thead th.is-main { background: var(--main); }
      .compare td.is-main { background: var(--main-light); }
      .mark-o { color: #d9534f; font-weight: 700; font-size: 1.1em; }
      .mark-t { color: #e0a100; font-weight: 700; }
      .mark-x { color: #999; font-weight: 700; }

      .post-content table {
        width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.6;
        display: block; overflow-x: auto; -webkit-overflow-scrolling: touch;
      }
      .post-content th, .post-content td {
        border: 1px solid var(--border); padding: 10px 12px; text-align: left;
      }
      .post-content thead th { background: #555; color: #fff; text-align: center; white-space: nowrap; }
      .post-content tbody th { background: #f4f4f2; white-space: nowrap; }
      .post-content tbody td { background: #fff; }

      /* ---------- Product box ---------- */
      .product-box {
        display: flex; gap: 20px; border: 1px solid var(--border); border-radius: var(--radius);
        padding: 20px; box-shadow: 0 2px 6px rgba(0, 0, 0, .05); background: #fff;
      }
      .product-box__img { width: 150px; flex-shrink: 0; }
      .product-box__dummy {
        aspect-ratio: 1; background: #f0f0ee; border-radius: 4px;
        display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 13px;
      }
      .product-box__body { flex: 1; min-width: 0; }
      .product-box__name { font-weight: 700; line-height: 1.5; margin: 0 0 4px !important; }
      .product-box__brand { font-size: 12px; color: var(--text-sub); margin: 0 !important; }
      .product-box__price { font-weight: 700; color: #c0392b; margin: 6px 0 12px !important; }
      .product-box__price small { font-weight: 400; color: var(--text-sub); font-size: 11px; }
      .product-box__btns { display: flex; gap: 8px; flex-wrap: wrap; }
      .shop-btn {
        flex: 1; min-width: 90px; text-align: center; color: #fff !important; font-weight: 700;
        font-size: 14px; padding: 9px 6px; border-radius: 4px; box-shadow: 0 3px 0 rgba(0, 0, 0, .15);
      }
      .shop-btn--a { background: #f79901; }
      .shop-btn--r { background: #bf0000; }
      .shop-btn--y { background: #e60033; }

      /* ---------- FAQ ---------- */
      .faq details { border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 10px; overflow: hidden; }
      .faq summary {
        list-style: none; cursor: pointer; padding: 14px 44px 14px 48px;
        font-weight: 700; position: relative; background: #fafaf8;
      }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::before {
        content: "Q"; position: absolute; left: 16px; top: 12px;
        color: var(--main); font-size: 18px; font-weight: 700;
      }
      .faq summary::after {
        content: "+"; position: absolute; right: 16px; top: 50%;
        transform: translateY(-50%); font-size: 20px; color: var(--text-sub);
      }
      .faq details[open] summary::after { content: "−"; }
      .faq__a { padding: 14px 18px 14px 48px; position: relative; border-top: 1px dashed var(--border); }
      .faq__a::before {
        content: "A"; position: absolute; left: 16px; top: 12px;
        color: var(--accent); font-size: 18px; font-weight: 700;
      }

      /* ---------- Blog card / CTA ---------- */
      .blogcard {
        display: flex; gap: 14px; border: 1px solid var(--border); border-radius: var(--radius);
        padding: 12px; color: var(--text) !important; transition: .2s; background: #fff;
      }
      .blogcard:hover { box-shadow: 0 4px 12px rgba(0, 0, 0, .08); opacity: 1; }
      .blogcard__thumb {
        width: 140px; aspect-ratio: 16/9; flex-shrink: 0; border-radius: 4px;
        background: linear-gradient(135deg, #6aa892, var(--main)); overflow: hidden;
      }
      .blogcard__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .blogcard__label {
        display: inline-block; font-size: 11px; background: var(--main);
        color: #fff; padding: 0 8px; border-radius: 2px;
      }
      .blogcard__title { font-weight: 700; line-height: 1.5; margin: 4px 0 0 !important; font-size: 15px; }
      .cta-btn {
        display: block; max-width: 420px; margin: 0 auto 2em; text-align: center;
        background: var(--accent); color: #fff !important; font-weight: 700; padding: 16px;
        border-radius: 40px; box-shadow: 0 4px 0 #b85f20; transition: .15s;
      }
      .cta-btn:hover { transform: translateY(2px); box-shadow: 0 2px 0 #b85f20; opacity: 1; }
      .cta-btn::after { content: " ›"; }

      /* ---------- 本文中のAmazonリンク（オレンジ系ピルボタン） ---------- */
      .post-content a[href*="amazon.co.jp"] {
        display: inline-block;
        background: linear-gradient(180deg, #f9a825 0%, #f08800 100%);
        color: #fff; font-weight: 700; text-decoration: none;
        padding: .4em 1.2em; margin: .15em .1em;
        border-radius: 999px;
        box-shadow: 0 2px 0 #b96e00;
        transition: transform .15s ease, filter .15s ease, box-shadow .15s ease;
      }
      .post-content a[href*="amazon.co.jp"]:hover {
        color: #fff; opacity: 1; filter: brightness(1.06);
        transform: translateY(1px); box-shadow: 0 1px 0 #b96e00;
      }

      /* ---------- Share ---------- */
      .share { text-align: center; margin: 48px 0 32px; padding-top: 32px; border-top: 1px solid var(--border); }
      .share__title { font-weight: 700; margin: 0 0 12px; }
      .share__list {
        list-style: none; padding: 0; margin: 0;
        display: flex; justify-content: center; gap: 8px; flex-wrap: wrap;
      }
      .sns {
        display: flex; align-items: center; justify-content: center;
        width: 64px; height: 40px; border-radius: 4px; color: #fff !important;
        font-weight: 700; font-size: 14px; border: none;
      }
      .sns--x { background: #000; }
      .sns--fb { background: #1877f2; }
      .sns--hb { background: #00a4de; }
      .sns--line { background: #06c755; font-size: 12px; }
      .sns--copy { background: #888; }
      .share__copied { font-size: 13px; color: var(--main); opacity: 0; transition: .3s; margin: 8px 0 0; }
      .share__copied.is-show { opacity: 1; }

      /* ---------- Prev / Next ---------- */
      .pn-links { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 40px; }
      .pn {
        border: 1px solid var(--border); border-radius: var(--radius);
        padding: 12px 16px; font-size: 14px; color: var(--text) !important; line-height: 1.5;
      }
      .pn span { display: block; font-size: 11px; color: var(--text-sub); margin-bottom: 4px; }
      .pn--prev span::before { content: "‹ "; }
      .pn--next { text-align: right; }
      .pn--next span::after { content: " ›"; }

      /* ---------- Author / Related ---------- */
      .section-title { font-size: 18px; text-align: center; margin: 0 0 20px; position: relative; }
      .section-title::after {
        content: ""; display: block; width: 40px; height: 3px;
        background: var(--main); margin: 8px auto 0;
      }
      .author { margin-bottom: 40px; }
      .author__inner {
        display: flex; gap: 20px; align-items: center;
        background: var(--bg); padding: 20px; border-radius: var(--radius);
      }
      .author__inner .avatar { margin: 0; flex-shrink: 0; }
      .author__name { font-weight: 700; margin: 0 0 4px; }
      .author__desc { font-size: 14px; margin: 0; color: #555; }
      .card-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
      .card-list a { color: var(--text); display: block; }
      .card-thumb {
        aspect-ratio: 16/9; border-radius: 4px; margin-bottom: 8px;
        transition: .2s; overflow: hidden;
      }
      .card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .card-list a:hover .card-thumb { opacity: .85; }
      .card-list p { font-size: 14px; font-weight: 500; line-height: 1.5; margin: 0 0 4px; }
      .card-list time { font-size: 12px; color: var(--text-sub); }
      .c1 { background: linear-gradient(135deg, #8fb9a8, #2f6f5e); }
      .c2 { background: linear-gradient(135deg, #f3c18c, #e8833a); }
      .c3 { background: linear-gradient(135deg, #a9c4e0, #4a7aa8); }
      .c4 { background: linear-gradient(135deg, #d6c3e0, #8a6aa8); }

      /* ---------- Sidebar ---------- */
      .l-sidebar { min-width: 0; }
      .widget { background: var(--white); border-radius: var(--radius); padding: 20px; margin-bottom: 24px; }
      .widget__title {
        font-size: 16px; margin: 0 0 14px; padding-bottom: 8px;
        border-bottom: 2px solid var(--main);
      }
      .widget--sticky { position: sticky; top: 20px; }
      .search-wrap { position: relative; }
      .search-form { display: flex; border: 1px solid var(--border); border-radius: 4px; overflow: hidden; }
      .search-form input {
        flex: 1; border: none; padding: 10px 12px; font: inherit; font-size: 14px;
        outline: none; min-width: 0;
      }
      .search-form button { border: none; background: var(--main); color: #fff; width: 44px; flex-shrink: 0; }
      .search-suggest {
        position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 30;
        list-style: none; margin: 0; padding: 6px 0; display: none;
        background: var(--white); border: 1px solid var(--border); border-radius: var(--radius);
        box-shadow: 0 8px 24px rgba(0, 0, 0, .12); max-height: 300px; overflow: auto;
      }
      .search-suggest.is-open { display: block; }
      .search-suggest a {
        display: block; padding: 8px 12px; color: var(--text); font-size: 13px; line-height: 1.5;
      }
      .search-suggest a:hover { background: var(--main-light); opacity: 1; }
      .profile { text-align: center; }
      .profile__name { font-weight: 700; margin: 8px 0 4px; }
      .profile__desc { font-size: 13px; color: #555; margin: 0; }
      .profile__link { font-size: 13px; margin: 8px 0 0; }
      .side-posts { list-style: none; padding: 0; margin: 0; }
      .side-posts li + li { margin-top: 12px; }
      .side-posts a { display: flex; gap: 10px; color: var(--text); }
      .side-thumb { width: 90px; aspect-ratio: 16/9; flex-shrink: 0; border-radius: 3px; overflow: hidden; }
      .side-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .side-posts p { margin: 0; font-size: 13px; line-height: 1.5; }
      .side-list { list-style: none; padding: 0; margin: 0; }
      .side-list a {
        display: block; padding: 8px 4px; border-bottom: 1px dotted var(--border);
        color: var(--text); font-size: 14px;
      }
      .side-list a::before { content: "›"; color: var(--main); margin-right: 8px; }
      .side-count { color: var(--text-sub); font-size: 12px; }
      .side-toc { margin: 0; padding-left: 1.4em; font-size: 13px; max-height: 60vh; overflow: auto; }
      .side-toc li { margin: .4em 0; }
      .side-toc a { color: var(--text); }
      .side-toc a.is-active { color: var(--main); font-weight: 700; }

      /* ---------- Footer ---------- */
      .l-footer { background: #333; color: #ccc; text-align: center; padding: 32px 0 24px; font-size: 13px; }
      .f-nav {
        list-style: none; display: flex; justify-content: center; flex-wrap: wrap;
        gap: 4px 24px; margin: 0 auto 12px;
      }
      .f-nav a { color: #ddd; }
      .f-disclosure { font-size: 11px; color: #999; line-height: 1.7; margin: 0 auto 12px; }
      .copyright { margin: 0; }

      /* ---------- Fixed buttons / modal ---------- */
      .fix-btns {
        position: fixed; right: 12px; bottom: 16px; display: flex; flex-direction: column;
        gap: 8px; z-index: 40; opacity: 0; pointer-events: none; transition: .3s;
      }
      .fix-btns.is-show { opacity: 1; pointer-events: auto; }
      .fix-btns button {
        width: 52px; height: 52px; border-radius: 50%; border: none;
        background: var(--main); color: #fff; font-size: 11px; line-height: 1.2;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .2);
      }
      #fixToc { display: none; }
      .toc-modal {
        position: fixed; inset: 0; background: rgba(0, 0, 0, .5); z-index: 100;
        display: none; align-items: center; justify-content: center; padding: 20px;
      }
      .toc-modal.is-open { display: flex; }
      .toc-modal__inner {
        background: #fff; border-radius: 8px; padding: 24px; width: 100%;
        max-width: 480px; max-height: 80vh; overflow: auto;
      }
      .toc-modal__title { font-weight: 700; margin: 0 0 10px; text-align: center; }
      .toc-modal ol { padding-left: 1.4em; margin: 0 0 16px; }
      .toc-modal li { margin: .5em 0; }
      .toc-modal a { color: var(--text); }
      .toc-modal__close {
        display: block; margin: 0 auto; border: 1px solid var(--border);
        background: #fff; border-radius: 20px; padding: 4px 24px;
      }

      /* =========================================================
         Responsive
         ========================================================= */
      @media (max-width: 959px) {
        /* ヘッダー(z-index:50)がスタッキングコンテキストを作り、中のドロワーメニューが
           オーバーレイ(55)より下に描画されてメニュー自体が暗くなる問題への対策。
           モバイルではヘッダー全体をオーバーレイより前面に出す */
        .l-header { z-index: 90; }
        .l-content { grid-template-columns: 1fr; gap: 24px; }
        .widget--sticky { display: none; }
        .l-header__inner { height: 60px; }
        .site-logo { font-size: 20px; }
        .site-logo small { display: none; }
        .menu-btn { display: flex; }
        .search-btn { display: block; }
        .g-nav {
          position: fixed; top: 0; left: 0; bottom: 0; width: 78%; max-width: 320px;
          background: #fff; transform: translateX(-100%); transition: .3s; z-index: 60;
          border: none; overflow-y: auto; padding-top: 20px;
        }
        .g-nav.is-open { transform: none; }
        .g-nav__list { flex-direction: column; padding: 0; }
        .g-nav__list a { padding: 14px 20px; border-bottom: 1px solid var(--border); }
        .g-nav__list a::after { display: none; }
        .overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, .4); z-index: 55; }
        .overlay.is-show { display: block; }
        #fixToc { display: block; }
      }
      @media (max-width: 599px) {
        body { font-size: 15px; }
        .l-container { padding: 0 12px; }
        .post { padding: 24px 16px; border-radius: 0; margin: 0 -12px; }
        .post-title { font-size: 21px; }
        .post-content h2 { font-size: 19px; padding: 12px 16px; }
        .post-content h3 { font-size: 17px; }
        .merit-demerit { grid-template-columns: 1fr; }
        .product-box { flex-direction: column; align-items: center; text-align: center; }
        .product-box__img { width: 140px; }
        .product-box__btns { justify-content: center; }
        .blogcard__thumb { width: 100px; }
        .card-list { gap: 14px; }
        .pn-links { grid-template-columns: 1fr; }
        .author__inner { flex-direction: column; text-align: center; }
      }
    </style>
  </head>
  <body>
    <header class="l-header">
      <div class="l-header__inner l-container">
        <button class="menu-btn" id="menuBtn" aria-label="メニュー" type="button"><span></span><span></span><span></span></button>
        <a href="/" class="site-logo">よるじかん<small>電源オフの暮らしと快眠道具</small></a>
        <button class="search-btn" id="searchBtn" aria-label="検索" type="button">
          <svg viewBox="0 0 24 24" width="22" height="22"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <nav class="g-nav" id="gNav">
        <ul class="g-nav__list l-container">
          <li><a href="/">ホーム</a></li>
          {navTags.map((tag) => (
            <li><a href={`/tags/${tag}/`}>{tag}</a></li>
          ))}
          <li><a href="/sleep-cycle/">睡眠サイクル計算</a></li>
          <li><a href="/about/">このサイトについて</a></li>
        </ul>
      </nav>
    </header>
    <div class="overlay" id="overlay"></div>

    {hasBreadcrumb && (
      <div class="breadcrumb">
        <ol class="l-container">
          <slot name="breadcrumb" />
        </ol>
      </div>
    )}

    <div class="l-content l-container">
      <main class="l-main">
        <slot />
      </main>
      <Sidebar toc={toc} />
    </div>

    <footer class="l-footer">
      <ul class="f-nav l-container">
        <li><a href="/">ホーム</a></li>
        <li><a href="/sleep-cycle/">睡眠サイクル計算ツール</a></li>
        <li><a href="/about/">このサイトについて</a></li>
      </ul>
      <p class="f-disclosure l-container">
        当サイトは、Amazon.co.jpを宣伝しリンクすることによってサイトが紹介料を獲得できる手段を提供することを目的に設定されたアフィリエイトプログラムである、Amazonアソシエイト・プログラムの参加者です。
      </p>
      <p class="copyright">© 2026 よるじかん</p>
    </footer>

    <div class="fix-btns">
      <button id="fixToc" type="button">目次</button>
      <button id="toTop" type="button">▲<br />TOP</button>
    </div>

    <div class="toc-modal" id="tocModal">
      <div class="toc-modal__inner">
        <p class="toc-modal__title">目次</p>
        <ol id="modalToc"></ol>
        <button class="toc-modal__close" id="tocClose" type="button">閉じる</button>
      </div>
    </div>

    <script src="/js/site.js" defer></script>
  </body>
</html>
