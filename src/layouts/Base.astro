---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Sidebar from '../components/Sidebar.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface Props {
  title: string;
  description: string;
  toc?: MarkdownHeading[];
}

const { title, description, toc = [] } = Astro.props;
const siteName = 'リピ買い図鑑｜売れ筋の数字で選ぶ消耗品・リピート品の比較サイト';
const pageTitle = title === siteName ? title : `${title}｜${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}ogp.png`, Astro.site);

// グローバルナビ用: カテゴリー（固定5分類）
const CATEGORIES = ['食品・飲料', 'コスメ・美容', '日用品・キッチン', 'ペット用品', 'ベビー'];
const navCategories = CATEGORIES;

const hasBreadcrumb = await Astro.slots.has('breadcrumb');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    <slot name="head" />
    <style is:global>
      /* =========================================================
         リピ買い図鑑 - デザイン v2（2026-11刷新）
         編集デザイン：余白とタイポグラフィを主役に、
         ブランド色は差し色に限定。グラデーションは使わない。
         ========================================================= */
      :root {
        --main: #e6361f;
        --main-deep: #bc2a12;
        --main-tint: #fdf1ed;
        --navy: #16324f;
        --ink: #171e27;
        --text: #262d36;
        --text-sub: #6f7784;
        --bg: #faf9f6;
        --bg-alt: #f2f0eb;
        --surface: #fff;
        --line: #e7e3db;
        --line-dark: #d8d3c8;
        --radius: 16px;
        --radius-s: 10px;
        --container: 1200px;
        --shadow-s: 0 1px 2px rgba(23, 30, 39, .04), 0 6px 18px rgba(23, 30, 39, .05);
        --shadow-m: 0 2px 4px rgba(23, 30, 39, .05), 0 18px 38px rgba(23, 30, 39, .11);
        --font-head: "Zen Kaku Gothic New", "Noto Sans JP", "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 20px; }
      body {
        margin: 0;
        font-family: "Noto Sans JP", "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.85;
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--main-deep); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible, input:focus-visible {
        outline: 2px solid rgba(230, 54, 31, .55); outline-offset: 2px;
      }
      img { max-width: 100%; height: auto; vertical-align: bottom; }
      ul, ol { padding-left: 1.5em; }
      button { font: inherit; cursor: pointer; }
      ::selection { background: #f6d9d2; }
      h1, h2, h3 { font-family: var(--font-head); letter-spacing: .02em; }

      .l-container { max-width: var(--container); margin: 0 auto; padding: 0 20px; }

      /* ---------- Motion（スクロール出現・ヒーロー） ---------- */
      .reveal {
        opacity: 0; transform: translateY(18px);
        transition: opacity .8s ease, transform .8s cubic-bezier(.16, .61, .36, 1);
      }
      .reveal.is-visible { opacity: 1; transform: translateY(0); }
      @keyframes rise {
        from { opacity: 0; transform: translateY(22px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .hero-anim { animation: rise .9s cubic-bezier(.16, .61, .36, 1) both; }
      .hero-anim.d1 { animation-delay: .08s; }
      .hero-anim.d2 { animation-delay: .16s; }
      .hero-anim.d3 { animation-delay: .26s; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .reveal { opacity: 1; transform: none; transition: none; }
        .hero-anim { animation: none; }
      }

      /* ---------- Header（白地・編集マストヘッド） ---------- */
      .l-header {
        background: rgba(255, 255, 255, .96);
        border-top: 3px solid var(--main);
        border-bottom: 1px solid var(--line);
        position: relative;
        z-index: 50;
      }
      .l-header__inner {
        display: flex; align-items: center; justify-content: center;
        height: 78px; position: relative;
      }
      .site-logo {
        font-family: var(--font-head);
        font-size: 27px; font-weight: 900; color: var(--ink); text-align: center;
        line-height: 1.3; letter-spacing: .05em;
      }
      .site-logo:hover { text-decoration: none; color: var(--ink); }
      .site-logo .logo-accent { color: var(--main); }
      .site-logo small {
        display: block; font-size: 11px; font-weight: 500;
        font-family: "Noto Sans JP", sans-serif;
        color: var(--text-sub); letter-spacing: .1em;
      }
      .menu-btn, .search-btn {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: none; border: none; color: var(--ink); display: none; padding: 8px;
      }
      .menu-btn { left: 8px; width: 40px; height: 40px; flex-direction: column; justify-content: center; gap: 5px; }
      .menu-btn span { display: block; height: 2px; background: currentColor; width: 22px; margin: 0 auto; transition: .3s; }
      .search-btn { right: 8px; }

      .g-nav { border-top: 1px solid var(--line); }
      .g-nav__list { display: flex; justify-content: center; flex-wrap: wrap; list-style: none; margin: 0 auto; padding: 0; }
      .g-nav__list a {
        display: block; padding: 13px 20px; color: var(--text);
        font-size: 14px; font-weight: 700; position: relative;
      }
      .g-nav__list a::after {
        content: ""; position: absolute; left: 20px; bottom: 7px; width: 0; height: 2px;
        background: var(--main); transition: width .3s cubic-bezier(.16, .61, .36, 1);
        border-radius: 2px;
      }
      .g-nav__list a:hover { text-decoration: none; color: var(--navy); }
      .g-nav__list a:hover::after { width: calc(100% - 40px); }
      .overlay { display: none; }

      /* ---------- Breadcrumb ---------- */
      .breadcrumb ol {
        list-style: none; display: flex; flex-wrap: wrap;
        margin: 0 auto; padding-top: 16px; padding-bottom: 4px;
        font-size: 12px; color: var(--text-sub);
      }
      .breadcrumb li:not(:last-child)::after { content: "›"; margin: 0 .6em; }
      .breadcrumb a { color: var(--text-sub); }

      /* ---------- Layout ---------- */
      .l-content {
        display: grid; grid-template-columns: minmax(0, 1fr) 300px;
        gap: 48px; padding-top: 24px; padding-bottom: 72px;
      }
      .l-main { min-width: 0; }

      /* ---------- Post head ---------- */
      .post {
        background: var(--surface); border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 48px 56px;
        box-shadow: var(--shadow-s);
      }
      .post-title {
        font-family: var(--font-head);
        font-size: 28px; font-weight: 900; line-height: 1.55;
        margin: 0 0 18px; color: var(--ink); letter-spacing: .01em;
      }
      .post-meta {
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        margin-bottom: 22px; font-size: 13px; color: var(--text-sub);
      }
      .cat-label {
        background: var(--surface); color: var(--navy); padding: 2px 13px;
        border: 1px solid var(--line-dark);
        border-radius: 999px; font-size: 12px; font-weight: 700;
      }
      a.cat-label:hover { border-color: var(--navy); text-decoration: none; }
      .date { display: inline-flex; align-items: center; gap: 4px; }
      .eyecatch { margin-bottom: 36px; }
      .eyecatch img { width: 100%; border-radius: var(--radius); display: block; }

      /* ---------- Post content ---------- */
      .post-content > * { margin-top: 0; margin-bottom: 1.9em; }
      .post-content p { margin-top: 0; }
      .post-content h2 {
        font-size: 23px; font-weight: 900; line-height: 1.55;
        color: var(--ink);
        padding: 0 0 13px;
        border-bottom: 1px solid var(--line);
        margin: 3em 0 1.3em; position: relative;
      }
      .post-content h2::after {
        content: ""; position: absolute; left: 0; bottom: -1px;
        width: 56px; height: 3px; background: var(--main); border-radius: 2px;
      }
      .post-content h3 {
        font-size: 18.5px; font-weight: 700; line-height: 1.55;
        padding: 2px 0 2px 16px; color: var(--ink);
        margin: 2.4em 0 1em; position: relative;
      }
      .post-content h3::before {
        content: ""; position: absolute; left: 0; top: .3em; bottom: .3em;
        width: 4px; border-radius: 2px; background: var(--main);
      }
      .post-content h4 { font-size: 17px; margin: 1.9em 0 .8em; }
      .post-content h4::before { content: "■"; color: var(--main); margin-right: .4em; font-size: .8em; }
      .post-content .marker, .marker {
        box-shadow: inset 0 -.52em 0 #f8e5a1; font-weight: 700;
      }
      .post-content .caption, .caption { font-size: 12px; color: var(--text-sub); margin-top: -1.3em !important; }
      .post-content img { border-radius: var(--radius); }
      .post-content blockquote {
        margin: 0 0 1.9em; padding: 16px 20px;
        background: var(--bg-alt); border-left: 3px solid var(--navy);
        border-radius: 0 var(--radius-s) var(--radius-s) 0; color: #4a4a44;
      }
      .post-content blockquote p:last-child { margin-bottom: 0; }
      .post-content code {
        background: #eef0f2; border-radius: 4px; padding: .1em .4em; font-size: .9em;
      }
      .post-content hr { border: none; border-top: 1px solid var(--line); }

      .pr-note {
        font-size: 13px; background: #f7f5f0; border: 1px solid var(--line);
        border-radius: var(--radius-s); padding: 12px 16px; color: #5d564a;
      }

      /* ---------- TOC ---------- */
      .toc { border: 1px solid var(--line); border-radius: 14px; padding: 0; overflow: hidden; }
      .toc__head {
        display: flex; justify-content: space-between; align-items: center;
        background: var(--bg-alt); padding: 11px 18px; font-weight: 700; color: var(--ink);
      }
      .toc__head span::before { content: "☰"; margin-right: .5em; color: var(--main); }
      .toc__toggle {
        background: var(--surface); border: 1px solid var(--line-dark);
        border-radius: 20px; font-size: 12px; padding: 2px 12px; color: var(--text);
      }
      .toc__list { margin: 0; padding: 16px 20px 16px 40px; }
      .toc__list li { margin: .35em 0; }
      .toc__list ol { padding-left: 1.4em; list-style: none; }
      .toc__list ol li::before { content: "– "; color: var(--text-sub); }
      .toc__list a { color: var(--text); }
      .toc__list > li > a { font-weight: 500; }
      .toc.is-closed .toc__list { display: none; }

      /* ---------- Boxes ---------- */
      .box { border-radius: var(--radius); padding: 22px 24px; position: relative; }
      .box > *:last-child { margin-bottom: 0; }
      .box__title { font-weight: 700; margin-bottom: 12px; }
      .box__label { display: block; font-weight: 700; margin-bottom: 4px; }
      .box--point { border: 1px solid rgba(230, 54, 31, .4); background: var(--surface); }
      .box--point .box__title { color: var(--main-deep); }
      .box--info { background: #eef3f7; border-left: 3px solid #7d99b4; }
      .box--alert { background: var(--main-tint); border-left: 3px solid var(--main); }
      .box--check { background: #fbf8f1; border: 1px dashed #d8c9a3; }

      .merit-demerit { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .merit, .demerit { border-radius: var(--radius-s); padding: 13px 15px; }
      .merit { background: #edf5ee; }
      .demerit { background: var(--main-tint); }
      .md-head { font-weight: 700; margin: 0 0 6px !important; }
      .merit .md-head { color: #3d7a4d; }
      .demerit .md-head { color: var(--main-deep); }
      .merit ul, .demerit ul { margin: 0; }

      .list-check, .list-x { list-style: none; padding-left: 0; }
      .list-check li, .list-x li { padding-left: 1.6em; position: relative; margin: .3em 0; }
      .list-check li::before { content: "✓"; position: absolute; left: 0; color: #3d7a4d; font-weight: 700; }
      .list-x li::before { content: "✕"; position: absolute; left: 0; color: var(--main); font-weight: 700; }
      .list-num { margin: 0; padding-left: 1.4em; }
      .list-num li { margin: .4em 0; }

      /* ---------- Balloon ---------- */
      .balloon { display: flex; gap: 16px; align-items: flex-start; }
      .balloon__icon { flex-shrink: 0; text-align: center; font-size: 11px; color: var(--text-sub); width: 64px; }
      .avatar {
        width: 64px; height: 64px; border-radius: 50%; background: var(--bg-alt);
        border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;
        font-size: 28px; margin: 0 auto 2px; color: var(--navy);
      }
      .avatar--lg { width: 88px; height: 88px; font-size: 38px; }
      .balloon__text {
        position: relative; background: var(--surface); border: 1px solid var(--line);
        border-radius: 12px; padding: 14px 18px; margin-top: 6px;
      }
      .balloon__text::before, .balloon__text::after {
        content: ""; position: absolute; top: 18px; border: 8px solid transparent;
      }
      .balloon__text::before { left: -17px; border-right-color: var(--line); }
      .balloon__text::after { left: -15px; border-right-color: var(--surface); }

      /* ---------- Table ---------- */
      .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .compare { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 14px; line-height: 1.6; }
      .compare th, .compare td { border: 1px solid var(--line); padding: 11px 12px; text-align: center; }
      .compare thead th { background: var(--bg-alt); color: var(--ink); border-bottom: 2px solid var(--line-dark); }
      .compare tbody th { background: #faf9f6; text-align: left; white-space: nowrap; }
      .compare thead th.is-main { background: var(--main-tint); color: var(--main-deep); }
      .compare td.is-main { background: #fff8f5; }
      .mark-o { color: var(--main); font-weight: 700; font-size: 1.1em; }
      .mark-t { color: #b07d10; font-weight: 700; }
      .mark-x { color: #a3a3a3; font-weight: 700; }

      .post-content table {
        width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.6;
        display: block; overflow-x: auto; -webkit-overflow-scrolling: touch;
      }
      .post-content th, .post-content td {
        border: 1px solid var(--line); padding: 11px 12px; text-align: left;
      }
      .post-content thead th {
        background: var(--bg-alt); color: var(--ink); text-align: center; white-space: nowrap;
        border-bottom: 2px solid var(--line-dark);
      }
      .post-content tbody th { background: #faf9f6; white-space: nowrap; }
      .post-content tbody td { background: #fff; }

      /* ---------- Product box（記事内の旧来ボックス） ---------- */
      .product-box {
        display: flex; gap: 20px; border: 1px solid var(--line); border-radius: var(--radius);
        padding: 22px; box-shadow: var(--shadow-s); background: var(--surface);
      }
      .product-box__img { width: 150px; flex-shrink: 0; }
      .product-box__dummy {
        aspect-ratio: 1; background: var(--bg-alt); border-radius: var(--radius-s);
        display: flex; align-items: center; justify-content: center; color: #a8a29a; font-size: 13px;
      }
      .product-box__body { flex: 1; min-width: 0; }
      .product-box__name { font-weight: 700; line-height: 1.5; margin: 0 0 4px !important; }
      .product-box__brand { font-size: 12px; color: var(--text-sub); margin: 0 !important; }
      .product-box__price { font-weight: 700; color: var(--main-deep); margin: 6px 0 12px !important; }
      .product-box__price small { font-weight: 400; color: var(--text-sub); font-size: 11px; }
      .product-box__btns { display: flex; gap: 8px; flex-wrap: wrap; }
      .shop-btn {
        flex: 1; min-width: 90px; text-align: center; color: #fff !important; font-weight: 700;
        font-size: 14px; padding: 10px 6px; border-radius: var(--radius-s);
        box-shadow: 0 1px 2px rgba(23, 30, 39, .18);
        transition: transform .2s ease, box-shadow .2s ease;
      }
      .shop-btn:hover { text-decoration: none; transform: translateY(-1px); box-shadow: 0 6px 16px rgba(23, 30, 39, .18); }
      .shop-btn--a { background: #ffa41c; color: #0f1111 !important; }
      .shop-btn--r { background: #bf0000; }
      .shop-btn--y { background: #e60033; }

      /* ---------- FAQ ---------- */
      .faq details { border: 1px solid var(--line); border-radius: 14px; margin-bottom: 10px; overflow: hidden; }
      .faq summary {
        list-style: none; cursor: pointer; padding: 15px 44px 15px 48px;
        font-weight: 700; position: relative; background: #fbfaf8;
      }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::before {
        content: "Q"; position: absolute; left: 16px; top: 13px;
        color: var(--main-deep); font-size: 18px; font-weight: 700;
      }
      .faq summary::after {
        content: "+"; position: absolute; right: 16px; top: 50%;
        transform: translateY(-50%); font-size: 20px; color: var(--text-sub);
      }
      .faq details[open] summary::after { content: "−"; }
      .faq__a { padding: 15px 18px 15px 48px; position: relative; border-top: 1px dashed var(--line); }
      .faq__a::before {
        content: "A"; position: absolute; left: 16px; top: 13px;
        color: var(--navy); font-size: 18px; font-weight: 700;
      }

      /* ---------- Blog card / CTA ---------- */
      .blogcard {
        display: flex; gap: 14px; border: 1px solid var(--line); border-radius: 14px;
        padding: 12px; color: var(--text) !important; background: var(--surface);
        transition: box-shadow .25s ease, transform .25s ease;
      }
      .blogcard:hover { box-shadow: var(--shadow-m); transform: translateY(-2px); text-decoration: none; }
      .blogcard__thumb {
        width: 140px; aspect-ratio: 16/9; flex-shrink: 0; border-radius: var(--radius-s);
        background: var(--bg-alt); overflow: hidden;
      }
      .blogcard__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .blogcard__label {
        display: inline-block; font-size: 11px; background: var(--navy);
        color: #fff; padding: 0 8px; border-radius: 3px;
      }
      .blogcard__title { font-weight: 700; line-height: 1.5; margin: 4px 0 0 !important; font-size: 15px; }
      .cta-btn {
        display: block; max-width: 420px; margin: 0 auto 2em; text-align: center;
        background: var(--main); color: #fff !important;
        font-weight: 700; padding: 16px;
        border-radius: 12px; box-shadow: var(--shadow-s);
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
      }
      .cta-btn:hover { background: var(--main-deep); transform: translateY(-1px); box-shadow: var(--shadow-m); text-decoration: none; }
      .cta-btn::after { content: " ›"; }

      /* ---------- 本文中のAmazonリンク（フラットなボタン） ---------- */
      .post-content p a[href*="amazon.co.jp"]:not(.product-card-btn):not(.pb-btn) {
        display: inline-block;
        background: #ffa41c;
        color: #0f1111; font-weight: 700; text-decoration: none;
        padding: .38em 1.15em; margin: .15em .1em;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(23, 30, 39, .18);
        transition: transform .2s ease, box-shadow .2s ease;
      }
      .post-content p a[href*="amazon.co.jp"]:not(.product-card-btn):not(.pb-btn):hover {
        color: #0f1111; transform: translateY(-1px); box-shadow: 0 6px 16px rgba(23, 30, 39, .18);
      }

      /* ---------- Share ---------- */
      .share { text-align: center; margin: 52px 0 34px; padding-top: 34px; border-top: 1px solid var(--line); }
      .share__title { font-weight: 700; margin: 0 0 14px; }
      .share__list {
        list-style: none; padding: 0; margin: 0;
        display: flex; justify-content: center; gap: 8px; flex-wrap: wrap;
      }
      .sns {
        display: flex; align-items: center; justify-content: center;
        width: 64px; height: 42px; border-radius: var(--radius-s); color: #fff !important;
        font-weight: 700; font-size: 14px; border: none;
        transition: transform .2s ease, box-shadow .2s ease;
      }
      .sns:hover { text-decoration: none; transform: translateY(-1px); box-shadow: var(--shadow-s); }
      .sns--x { background: #000; }
      .sns--fb { background: #1877f2; }
      .sns--hb { background: #00a4de; }
      .sns--line { background: #06c755; font-size: 12px; }
      .sns--copy { background: #6f7784; }
      .share__copied { font-size: 13px; color: var(--main-deep); opacity: 0; transition: .3s; margin: 8px 0 0; }
      .share__copied.is-show { opacity: 1; }

      /* ---------- Prev / Next ---------- */
      .pn-links { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 44px; }
      .pn {
        border: 1px solid var(--line); border-radius: 14px;
        padding: 14px 18px; font-size: 14px; color: var(--text) !important; line-height: 1.5;
        transition: box-shadow .25s ease, transform .25s ease;
      }
      .pn:hover { box-shadow: var(--shadow-s); transform: translateY(-2px); text-decoration: none; }
      .pn span { display: block; font-size: 11px; color: var(--text-sub); margin-bottom: 4px; }
      .pn--prev span::before { content: "‹ "; }
      .pn--next { text-align: right; }
      .pn--next span::after { content: " ›"; }

      /* ---------- Author / Related ---------- */
      .section-title {
        font-family: var(--font-head);
        font-size: 20px; font-weight: 900; text-align: left;
        margin: 0 0 22px; color: var(--ink);
        display: flex; align-items: center; gap: 14px;
      }
      .section-title::before {
        content: ""; width: 30px; height: 3px; flex-shrink: 0;
        background: var(--main); border-radius: 2px;
      }
      .author { margin-bottom: 44px; }
      .author__inner {
        display: flex; gap: 20px; align-items: center;
        background: var(--bg-alt); border: 1px solid var(--line);
        padding: 22px; border-radius: 14px;
      }
      .author__inner .avatar { margin: 0; flex-shrink: 0; background: var(--surface); }
      .author__name { font-weight: 700; margin: 0 0 4px; }
      .author__desc { font-size: 14px; margin: 0; color: #55534e; }
      .card-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
      .card-list a { color: var(--text); display: block; }
      .card-list a:hover { text-decoration: none; }
      .card-thumb {
        aspect-ratio: 16/9; border-radius: var(--radius-s); margin-bottom: 10px;
        overflow: hidden; background: var(--bg-alt);
      }
      .card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s cubic-bezier(.16, .61, .36, 1); }
      .card-list a:hover .card-thumb img { transform: scale(1.04); }
      .card-list a:hover p { color: var(--main-deep); }
      .card-list p { font-size: 14px; font-weight: 500; line-height: 1.55; margin: 0 0 4px; transition: color .2s ease; }
      .card-list time { font-size: 12px; color: var(--text-sub); }
      .c1, .c2, .c3, .c4 { background: var(--bg-alt); }

      /* ---------- Sidebar ---------- */
      .l-sidebar { min-width: 0; }
      .widget {
        background: var(--surface); border: 1px solid var(--line);
        border-radius: var(--radius); padding: 22px; margin-bottom: 24px;
      }
      .widget__title {
        font-family: var(--font-head);
        font-size: 15px; font-weight: 900; color: var(--ink);
        margin: 0 0 16px; padding-bottom: 11px; position: relative;
        border-bottom: 1px solid var(--line);
      }
      .widget__title::after {
        content: ""; position: absolute; left: 0; bottom: -1px;
        width: 36px; height: 3px; background: var(--main); border-radius: 2px;
      }
      .widget--sticky { position: sticky; top: 20px; }
      .search-wrap { position: relative; }
      .search-form { display: flex; border: 1px solid var(--line-dark); border-radius: var(--radius-s); overflow: hidden; }
      .search-form input {
        flex: 1; border: none; padding: 10px 12px; font: inherit; font-size: 14px;
        outline: none; min-width: 0; background: var(--surface);
      }
      .search-form button { border: none; background: var(--navy); color: #fff; width: 44px; flex-shrink: 0; }
      .search-suggest {
        position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 30;
        list-style: none; margin: 0; padding: 6px 0; display: none;
        background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
        box-shadow: var(--shadow-m); max-height: 300px; overflow: auto;
      }
      .search-suggest.is-open { display: block; }
      .search-suggest a {
        display: block; padding: 8px 12px; color: var(--text); font-size: 13px; line-height: 1.5;
      }
      .search-suggest a:hover { background: var(--bg-alt); text-decoration: none; }
      .profile { text-align: center; }
      .profile__name { font-weight: 700; margin: 8px 0 4px; }
      .profile__desc { font-size: 13px; color: #55534e; margin: 0; }
      .profile__link { font-size: 13px; margin: 8px 0 0; }
      .side-posts { list-style: none; padding: 0; margin: 0; }
      .side-posts li + li { margin-top: 14px; }
      .side-posts a { display: flex; gap: 12px; color: var(--text); }
      .side-posts a:hover { text-decoration: none; }
      .side-posts a:hover p { color: var(--main-deep); }
      .side-posts p { transition: color .2s ease; }
      .side-thumb { width: 90px; aspect-ratio: 16/9; flex-shrink: 0; border-radius: 8px; overflow: hidden; background: var(--bg-alt); }
      .side-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .side-list { list-style: none; padding: 0; margin: 0; }
      .side-list a {
        display: block; padding: 9px 4px; border-bottom: 1px dotted var(--line-dark);
        color: var(--text); font-size: 14px;
      }
      .side-list a::before { content: "›"; color: var(--main); margin-right: 8px; font-weight: 700; }
      .side-count { color: var(--text-sub); font-size: 12px; }
      .side-toc { margin: 0; padding-left: 1.4em; font-size: 13px; max-height: 60vh; overflow: auto; }
      .side-toc li { margin: .45em 0; }
      .side-toc a { color: var(--text); }
      .side-toc a.is-active { color: var(--main-deep); font-weight: 700; }

      /* ---------- Footer（ニュートラルな濃色） ---------- */
      .l-footer { background: #171d26; color: #b9c2cc; text-align: center; padding: 44px 0 28px; font-size: 13px; }
      .f-nav {
        list-style: none; display: flex; justify-content: center; flex-wrap: wrap;
        gap: 4px 26px; margin: 0 auto 14px;
      }
      .f-nav a { color: #e8edf2; font-weight: 500; }
      .f-disclosure { font-size: 11px; color: #7f8b98; line-height: 1.7; margin: 0 auto 12px; }
      .copyright { margin: 0; color: #7f8b98; }

      /* ---------- Fixed buttons / modal ---------- */
      .fix-btns {
        position: fixed; right: 14px; bottom: 18px; display: flex; flex-direction: column;
        gap: 8px; z-index: 40; opacity: 0; pointer-events: none;
        transition: opacity .35s ease, transform .35s ease; transform: translateY(6px);
      }
      .fix-btns.is-show { opacity: 1; pointer-events: auto; transform: translateY(0); }
      .fix-btns button {
        width: 46px; height: 46px; border-radius: 50%;
        border: 1px solid var(--line-dark);
        background: rgba(255, 255, 255, .94); backdrop-filter: blur(6px);
        color: var(--text); font-size: 10px; font-weight: 700; line-height: 1.25;
        box-shadow: var(--shadow-m);
        transition: color .2s ease, border-color .2s ease;
      }
      .fix-btns button:hover { color: var(--main-deep); border-color: var(--main); }
      #fixToc { display: none; }
      .toc-modal {
        position: fixed; inset: 0; background: rgba(23, 29, 38, .5); z-index: 100;
        display: none; align-items: center; justify-content: center; padding: 20px;
      }
      .toc-modal.is-open { display: flex; }
      .toc-modal__inner {
        background: #fff; border-radius: var(--radius); padding: 26px; width: 100%;
        max-width: 480px; max-height: 80vh; overflow: auto;
      }
      .toc-modal__title { font-weight: 700; margin: 0 0 10px; text-align: center; }
      .toc-modal ol { padding-left: 1.4em; margin: 0 0 16px; }
      .toc-modal li { margin: .5em 0; }
      .toc-modal a { color: var(--text); }
      .toc-modal__close {
        display: block; margin: 0 auto; border: 1px solid var(--line-dark);
        background: #fff; border-radius: 20px; padding: 5px 26px; color: var(--text);
      }

      /* =========================================================
         Responsive
         ========================================================= */
      @media (max-width: 959px) {
        /* ヘッダー(z-index:50)がスタッキングコンテキストを作り、中のドロワーメニューが
           オーバーレイ(55)より下に描画されてメニュー自体が暗くなる問題への対策。
           モバイルではヘッダー全体をオーバーレイより前面に出す */
        .l-header { z-index: 90; }
        .l-content { grid-template-columns: 1fr; gap: 28px; }
        .widget--sticky { display: none; }
        .l-header__inner { height: 62px; }
        .site-logo { font-size: 21px; }
        .site-logo small { display: none; }
        .menu-btn { display: flex; }
        .search-btn { display: block; }
        .g-nav {
          position: fixed; top: 0; left: 0; bottom: 0; width: 78%; max-width: 320px;
          background: #fff; transform: translateX(-100%); transition: .3s; z-index: 60;
          border: none; overflow-y: auto; padding-top: 20px;
          box-shadow: var(--shadow-m);
        }
        .g-nav.is-open { transform: none; }
        .g-nav__list { flex-direction: column; padding: 0; }
        .g-nav__list a { padding: 14px 20px; border-bottom: 1px solid var(--line); color: var(--text); }
        .g-nav__list a::after { display: none; }
        .overlay { position: fixed; inset: 0; background: rgba(23, 29, 38, .45); z-index: 55; }
        .overlay.is-show { display: block; }
        #fixToc { display: block; }
      }
      @media (max-width: 599px) {
        body { font-size: 15px; }
        .l-container { padding: 0 14px; }
        .post { padding: 26px 18px; border-radius: 0; margin: 0 -14px; border-left: none; border-right: none; }
        .post-title { font-size: 22px; }
        .post-content h2 { font-size: 20px; }
        .post-content h3 { font-size: 17px; }
        .merit-demerit { grid-template-columns: 1fr; }
        .product-box { flex-direction: column; align-items: center; text-align: center; }
        .product-box__img { width: 140px; }
        .product-box__btns { justify-content: center; }
        .blogcard__thumb { width: 100px; }
        .card-list { gap: 16px; }
        .pn-links { grid-template-columns: 1fr; }
        .author__inner { flex-direction: column; text-align: center; }
      }

    </style>
    <meta name="google-site-verification" content="n4sVIMCNLli36HHN4-dtuNoeEnew3wVhhdkAGhvDfZo" />
  </head>
  <body>
    <header class="l-header">
      <div class="l-header__inner l-container">
        <button class="menu-btn" id="menuBtn" aria-label="メニュー" type="button"><span></span><span></span><span></span></button>
        <a href={base} class="site-logo">リピ買い<span class="logo-accent">図鑑</span><small>売れ筋の数字で選ぶ、消耗品・リピート品の比較サイト</small></a>
        <button class="search-btn" id="searchBtn" aria-label="検索" type="button">
          <svg viewBox="0 0 24 24" width="22" height="22"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <nav class="g-nav" id="gNav">
        <ul class="g-nav__list l-container">
          <li><a href={base}>ホーム</a></li>
          {navCategories.map((category) => (
            <li><a href={`${base}categories/${category}/`}>{category}</a></li>
          ))}
          <li><a href={`${base}about/`}>運営者情報</a></li>
        </ul>
      </nav>
    </header>
    <div class="overlay" id="overlay"></div>

    {hasBreadcrumb && (
      <div class="breadcrumb">
        <ol class="l-container">
          <slot name="breadcrumb" />
        </ol>
      </div>
    )}

    <div class="l-content l-container">
      <main class="l-main">
        <slot />
      </main>
      <Sidebar toc={toc} />
    </div>

    <footer class="l-footer">
      <ul class="f-nav l-container">
        <li><a href={base}>ホーム</a></li>
        <li><a href={`${base}about/`}>運営者情報</a></li>
        <li><a href={`${base}privacy/`}>プライバシーポリシー</a></li>
        <li><a href={`${base}disclaimer/`}>免責事項</a></li>
      </ul>
      <p class="f-disclosure l-container">
        当サイトは、Amazon.co.jpを宣伝しリンクすることによってサイトが紹介料を獲得できる手段を提供することを目的に設定されたアフィリエイトプログラムである、Amazonアソシエイト・プログラムの参加者です。また、楽天アフィリエイト・プログラムにも参加しています。
      </p>
      <p class="copyright">© 2026 リピ買い図鑑</p>
    </footer>

    <div class="fix-btns">
      <button id="fixToc" type="button">目次</button>
      <button id="toTop" type="button">▲<br />TOP</button>
    </div>

    <div class="toc-modal" id="tocModal">
      <div class="toc-modal__inner">
        <p class="toc-modal__title">目次</p>
        <ol id="modalToc"></ol>
        <button class="toc-modal__close" id="tocClose" type="button">閉じる</button>
      </div>
    </div>

    <script src={`${base}js/site.js`} defer></script>
  </body>
</html>
