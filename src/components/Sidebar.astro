---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  toc?: MarkdownHeading[];
}

const { toc = [] } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const recent = posts.slice(0, 5);

// カテゴリー（タグ＋件数、件数の多い順）
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'),
);

// 検索サジェスト用インデックス（全記事タイトル＋URL）
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  url: `/blog/${post.id}/`,
}));

const sideToc = toc.filter((h) => h.depth === 2);
---

<aside class="l-sidebar">
  <div class="widget">
    <div class="search-wrap">
      <form class="search-form" id="searchForm" role="search">
        <input
          type="search"
          id="searchInput"
          placeholder="記事を検索"
          autocomplete="off"
          aria-label="記事を検索"
        />
        <button type="submit" aria-label="検索">
          <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </form>
      <ul class="search-suggest" id="searchSuggest"></ul>
    </div>
    <script type="application/json" id="search-index" is:inline set:html={JSON.stringify(searchIndex)} />
  </div>

  <div class="widget">
    <h3 class="widget__title">プロフィール</h3>
    <div class="profile">
      <div class="avatar avatar--lg">☾</div>
      <p class="profile__name">よるじかん編集部</p>
      <p class="profile__desc">
        寝る前のセルフケアと快眠道具を調べるのが好きな個人運営ブログです。実際に使ったもの・調べたものを、正直にまとめています。
      </p>
      <p class="profile__link"><a href="/about/">このブログについて →</a></p>
    </div>
  </div>

  <div class="widget">
    <h3 class="widget__title">最近の投稿</h3>
    <ul class="side-posts">
      {recent.map((post, i) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <div class={`side-thumb c${(i % 4) + 1}`}>
              {post.data.heroImage && (
                <img src={post.data.heroImage} alt="" loading="lazy" />
              )}
            </div>
            <p>{post.data.title}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="widget">
    <h3 class="widget__title">カテゴリー</h3>
    <ul class="side-list">
      {tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}/`}>{tag}<span class="side-count">（{count}）</span></a>
        </li>
      ))}
    </ul>
  </div>

  {sideToc.length > 0 && (
    <div class="widget widget--sticky">
      <h3 class="widget__title">目次</h3>
      <ol class="side-toc" id="sideToc">
        {sideToc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  )}
</aside>
