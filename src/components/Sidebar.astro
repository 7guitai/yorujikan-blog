---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const withBase = (path: string | undefined) => (path && path.startsWith('/') ? `${base}${path.slice(1)}` : path);

interface Props {
  toc?: MarkdownHeading[];
}

const { toc = [] } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const recent = posts.slice(0, 5);

// カテゴリー（固定5分類＋件数）
const CATEGORIES = ['食品・飲料', 'コスメ・美容', '日用品・キッチン', 'ペット用品', 'ベビー'];
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
const categories = CATEGORIES.map(
  (category) => [category, categoryCounts.get(category) ?? 0] as [string, number],
);

// 検索サジェスト用インデックス（全記事タイトル＋URL）
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  url: `${base}blog/${post.id}/`,
}));

const sideToc = toc.filter((h) => h.depth === 2);
---

<aside class="l-sidebar">
  <div class="widget">
    <div class="search-wrap">
      <form class="search-form" id="searchForm" role="search">
        <input
          type="search"
          id="searchInput"
          placeholder="記事を検索"
          autocomplete="off"
          aria-label="記事を検索"
        />
        <button type="submit" aria-label="検索">
          <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </form>
      <ul class="search-suggest" id="searchSuggest"></ul>
    </div>
    <script type="application/json" id="search-index" is:inline set:html={JSON.stringify(searchIndex)} />
  </div>

  <div class="widget">
    <h3 class="widget__title">プロフィール</h3>
    <div class="profile">
      <div class="avatar avatar--lg">↻</div>
      <p class="profile__name">リピ買い図鑑編集部</p>
      <p class="profile__desc">
        売れ筋の数字（ランキング順位・レビュー件数・単価）をもとに、消耗品・リピート品を比較する個人運営サイトです。スペック・価格・レビュー傾向を、正直にまとめています。
      </p>
      <p class="profile__link"><a href={`${base}about/`}>運営者情報 →</a></p>
    </div>
  </div>

  <div class="widget">
    <h3 class="widget__title">最近の投稿</h3>
    <ul class="side-posts">
      {recent.map((post, i) => (
        <li>
          <a href={`${base}blog/${post.id}/`}>
            <div class={`side-thumb c${(i % 4) + 1}`}>
              {post.data.heroImage && (
                <img src={withBase(post.data.heroImage)} alt="" loading="lazy" />
              )}
            </div>
            <p>{post.data.title}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="widget">
    <h3 class="widget__title">カテゴリー</h3>
    <ul class="side-list">
      {categories.map(([category, count]) => (
        <li>
          <a href={`${base}categories/${category}/`}>{category}<span class="side-count">（{count}）</span></a>
        </li>
      ))}
    </ul>
  </div>

  {sideToc.length > 0 && (
    <div class="widget widget--sticky">
      <h3 class="widget__title">目次</h3>
      <ol class="side-toc" id="sideToc">
        {sideToc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  )}
</aside>
