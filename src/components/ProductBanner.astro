---
// 商品バナー：記事中に差し込む横長バナー。左に商品画像、右に商品名・価格・一言説明・購入ボタン。
// リンク生成仕様は ProductCard と同じ（Amazon は tag=kobebooka1-22、rel="nofollow sponsored noopener"）。
// 使い方（.mdx記事内）:
//   import ProductBanner from '../../components/ProductBanner.astro';
//   <ProductBanner name="商品名" asin="B0XXXXXXXX" price="¥3,490〜" note="特徴を一言で" image="/images/banner-xxx.jpg" rakutenUrl="https://..." />
interface Props {
  name: string;
  asin?: string;
  amazonUrl?: string;
  rakutenUrl?: string;
  price?: string;
  note?: string;
  image?: string;
}
const { name, asin, amazonUrl, rakutenUrl, price, note, image } = Astro.props;
const TAG = 'kobebooka1-22';
const amazon = amazonUrl ?? (asin ? `https://www.amazon.co.jp/dp/${asin}?tag=${TAG}` : undefined);
---

<aside class="product-banner reveal">
  {image && (
    <div class="pb-media">
      <img src={image} alt={name} loading="lazy" />
    </div>
  )}
  <div class="pb-body">
    <p class="pb-eyebrow">おすすめ No.1</p>
    <p class="pb-name">{name}</p>
    {price && <p class="pb-price">{price}</p>}
    {note && <p class="pb-note">{note}</p>}
    <div class="pb-actions">
      {amazon && (
        <a class="pb-btn pb-btn-amazon" href={amazon} target="_blank" rel="nofollow sponsored noopener">Amazonで見る</a>
      )}
      {rakutenUrl && (
        <a class="pb-btn pb-btn-rakuten" href={rakutenUrl} target="_blank" rel="nofollow sponsored noopener">楽天市場で見る</a>
      )}
    </div>
    <p class="pb-caption">※価格・在庫は変動します。最新の情報は販売ページでご確認ください。</p>
  </div>
</aside>

<style>
  .product-banner {
    display: flex;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-s);
    overflow: hidden;
    margin: 30px 0;
  }
  .pb-media {
    flex: 0 0 36%;
    background: var(--bg-alt);
    min-height: 100%;
    padding: 16px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pb-media img {
    width: 100%;
    height: 100%;
    max-height: 260px;
    object-fit: contain;
    display: block;
    border-radius: 0;
  }
  .pb-body {
    flex: 1 1 auto;
    min-width: 0;
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pb-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    color: var(--main-deep);
    margin: 0 0 8px;
  }
  .pb-name {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 1.18rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .pb-price {
    font-family: var(--font-head);
    color: var(--main-deep);
    font-weight: 900;
    font-size: 1.45rem;
    line-height: 1.35;
    letter-spacing: .01em;
    margin: 0 0 8px;
  }
  .pb-note {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .pb-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pb-btn {
    display: inline-block;
    padding: 12px 26px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 1px 2px rgba(23, 30, 39, .18);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .pb-btn-amazon {
    background: #ffa41c;
    color: #0f1111;
  }
  .pb-btn-rakuten {
    background: #bf0000;
    color: #fff;
  }
  .pb-btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(23, 30, 39, .18);
  }
  .pb-btn-amazon:hover { color: #0f1111; }
  .pb-btn-rakuten:hover { color: #fff; }
  .pb-caption {
    color: var(--text-sub);
    font-size: 0.78rem;
    margin: 12px 0 0;
  }
  @media (max-width: 640px) {
    .product-banner {
      flex-direction: column;
    }
    .pb-media {
      flex: none;
      aspect-ratio: 16 / 9;
    }
    .pb-body {
      padding: 20px;
    }
    .pb-btn {
      flex: 1 1 100%;
    }
  }
</style>
