---
// 商品カード：Amazon（tag=kobebooka1-22）／楽天アフィリエイトリンクをカード形式で表示する。
// 使い方（.mdx記事内）:
//   import ProductCard from '../../components/ProductCard.astro';
//   <ProductCard name="商品名" asin="B0XXXXXXXX" price="¥3,490〜" note="特徴を一言で" image="https://..." rakutenUrl="https://..." />
interface Props {
  name: string;
  asin?: string;
  amazonUrl?: string;
  rakutenUrl?: string;
  price?: string;
  note?: string;
  image?: string;
}
const { name, asin, amazonUrl, rakutenUrl, price, note, image } = Astro.props;
const TAG = 'kobebooka1-22';
const amazon = amazonUrl ?? (asin ? `https://www.amazon.co.jp/dp/${asin}?tag=${TAG}` : undefined);
---

<aside class="product-card reveal">
  {image && (
    <div class="product-card-media">
      <img src={image} alt={name} loading="lazy" />
    </div>
  )}
  <div class="product-card-body">
    <p class="product-card-name">{name}</p>
    {price && <p class="product-card-price">{price}</p>}
    {note && <p class="product-card-note">{note}</p>}
    <div class="product-card-actions">
      {amazon && (
        <a class="product-card-btn product-card-btn-amazon" href={amazon} target="_blank" rel="nofollow sponsored noopener">Amazonで見る</a>
      )}
      {rakutenUrl && (
        <a class="product-card-btn product-card-btn-rakuten" href={rakutenUrl} target="_blank" rel="nofollow sponsored noopener">楽天市場で見る</a>
      )}
    </div>
    <p class="product-card-caption">※価格・在庫は変動します。最新の情報は販売ページでご確認ください。</p>
  </div>
</aside>

<style>
  .product-card {
    display: flex;
    gap: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-s);
    padding: 22px;
    margin: 24px 0;
  }
  .product-card-media {
    flex: 0 0 148px;
    background: var(--bg-alt);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    align-self: flex-start;
  }
  .product-card-media img {
    width: 128px;
    height: 128px;
    object-fit: contain;
    display: block;
    border-radius: 6px;
  }
  .product-card-body {
    flex: 1 1 auto;
    min-width: 0;
  }
  .product-card-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.03rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .product-card-price {
    font-family: var(--font-head);
    color: var(--main-deep);
    font-weight: 900;
    font-size: 1.28rem;
    line-height: 1.4;
    letter-spacing: .01em;
    margin: 0 0 8px;
  }
  .product-card-note {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 16px;
  }
  .product-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .product-card-btn {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 1px 2px rgba(23, 30, 39, .18);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .product-card-btn-amazon {
    background: #ffa41c;
    color: #0f1111;
  }
  .product-card-btn-rakuten {
    background: #bf0000;
    color: #fff;
  }
  .product-card-btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(23, 30, 39, .18);
  }
  .product-card-btn-amazon:hover { color: #0f1111; }
  .product-card-btn-rakuten:hover { color: #fff; }
  .product-card-caption {
    color: var(--text-sub);
    font-size: 0.78rem;
    margin: 12px 0 0;
  }
  @media (max-width: 640px) {
    .product-card {
      flex-direction: column;
      gap: 12px;
      padding: 18px;
    }
    .product-card-media {
      flex: none;
      align-self: stretch;
    }
    .product-card-media img {
      margin: 0 auto;
    }
    .product-card-btn {
      flex: 1 1 100%;
    }
  }

</style>
