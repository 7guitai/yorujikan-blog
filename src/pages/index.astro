---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const featured = posts[0];
const restPosts = posts.slice(1);

// 全タグ（記事数の多い順、同数なら名前順）
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'),
);

const formatDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---

<Base
  title="よるじかん｜電源オフの暮らしと快眠道具"
  description="寝る前のセルフケアや快眠グッズを、選び方と比較とあわせて紹介する個人ブログ「よるじかん」の記事一覧です。"
>
  <h1>よるじかん</h1>
  <p class="lead">寝る前の時間を整えるセルフケアグッズ・快眠道具を、選び方と比較とあわせて紹介しています。</p>

  {featured && (
    <section class="featured">
      <h2 class="section-title">おすすめ記事</h2>
      <a class="featured-card" href={`/blog/${featured.id}/`}>
        <span class="featured-thumb">
          {featured.data.heroImage ? (
            <img src={featured.data.heroImage} alt="" />
          ) : (
            <span class="featured-thumb-empty">☾</span>
          )}
          <span class="featured-badge">最新記事</span>
        </span>
        <span class="featured-body">
          <span class="featured-title">{featured.data.title}</span>
          <span class="featured-meta">
            <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
            {featured.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </span>
          <span class="featured-desc">{featured.data.description}</span>
          <span class="featured-more">記事を読む →</span>
        </span>
      </a>
    </section>
  )}

  <section class="tag-section">
    <h2 class="section-title">タグから探す</h2>
    <ul class="tag-chips">
      {allTags.map(([tag, count]) => (
        <li>
          <a class="tag-chip" href={`/tags/${tag}/`}>{tag}<span class="tag-count">{count}</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="section-title">記事一覧</h2>
    <ul class="post-list">
      {restPosts.map((post) => (
        <li class="post-card">
          <a href={`/blog/${post.id}/`} class="post-thumb" aria-hidden="true" tabindex="-1">
            {post.data.heroImage ? (
              <img src={post.data.heroImage} alt="" loading="lazy" />
            ) : (
              <span class="post-thumb-empty">☾</span>
            )}
          </a>
          <div class="post-body">
            <a href={`/blog/${post.id}/`} class="post-title">{post.data.title}</a>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <p class="post-desc">{post.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
  <style>
    .lead { color: var(--muted); margin: 0 0 30px; }
    .section-title {
      font-family: "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Yu Mincho", "YuMincho", serif;
      font-size: 1.3rem; font-weight: 600;
      margin: 42px 0 18px; padding-bottom: 0.4em;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
    }
    .section-title::before { content: "☾"; color: var(--accent); font-size: 1.1rem; }
    section:first-of-type .section-title { margin-top: 0; }

    /* ---------- おすすめ記事（特集） ---------- */
    .featured-card {
      display: block;
      background: var(--card);
      border: 1px solid var(--accent);
      border-radius: var(--radius);
      overflow: hidden;
      text-decoration: none;
      color: var(--text);
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .featured-card:hover { background: var(--card-hover); transform: translateY(-2px); color: var(--text); }
    .featured-thumb { display: block; position: relative; aspect-ratio: 21 / 9; overflow: hidden; background: #232c4c; }
    .featured-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .featured-thumb-empty {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 3.4rem; color: var(--accent);
      background: linear-gradient(135deg, #1c2547 0%, #2a3355 55%, #3a4570 100%);
    }
    .featured-badge {
      position: absolute; top: 14px; left: 14px;
      background: var(--accent); color: #2a2008;
      font-size: 0.78rem; font-weight: 700;
      padding: 3px 12px; border-radius: 999px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }
    .featured-body { display: block; padding: 22px 26px 24px; }
    .featured-title {
      display: block;
      font-size: 1.3rem; font-weight: 700; line-height: 1.6;
      font-family: "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Yu Mincho", "YuMincho", serif;
    }
    .featured-card:hover .featured-title { color: var(--accent); }
    .featured-meta { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 0.82rem; margin-top: 10px; flex-wrap: wrap; }
    .featured-desc { display: block; margin-top: 12px; color: var(--muted); font-size: 0.95rem; line-height: 1.85; }
    .featured-more { display: inline-block; margin-top: 14px; color: var(--accent); font-weight: 700; font-size: 0.92rem; }

    /* ---------- タグチップ ---------- */
    .tag-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
    .tag-chip {
      display: inline-flex; align-items: center; gap: 7px;
      background: #232c4c; color: var(--accent-soft);
      border: 1px solid var(--border); border-radius: 999px;
      padding: 4px 14px; font-size: 0.88rem; text-decoration: none;
      transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    }
    .tag-chip:hover { color: var(--accent); border-color: var(--accent); background: var(--card-hover); }
    .tag-count {
      background: var(--surface); color: var(--muted);
      border-radius: 999px; padding: 0 7px; font-size: 0.74rem; line-height: 1.7;
    }

    /* ---------- 記事カード ---------- */
    .post-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 22px; }
    .post-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .post-card:hover { background: var(--card-hover); transform: translateY(-2px); }
    .post-thumb { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #232c4c; }
    .post-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .post-thumb-empty {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.6rem; color: var(--accent);
      background: linear-gradient(135deg, #1c2547 0%, #2a3355 55%, #3a4570 100%);
    }
    .post-body { padding: 18px 22px 20px; }
    .post-title {
      font-size: 1.12rem; font-weight: 700; line-height: 1.6;
      color: var(--text); text-decoration: none;
    }
    .post-title:hover { color: var(--accent); }
    .post-meta { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 0.82rem; margin-top: 8px; flex-wrap: wrap; }
    .post-desc { margin: 10px 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.75; }
    @media (max-width: 640px) {
      .post-body { padding: 15px 16px 17px; }
      .featured-body { padding: 17px 16px 19px; }
      .featured-title { font-size: 1.14rem; }
      .featured-thumb { aspect-ratio: 16 / 9; }
    }
  </style>
</Base>
