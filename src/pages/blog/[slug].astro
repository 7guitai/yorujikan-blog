---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const formatDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

// 目次: h2 の見出しから生成
const tocHeadings = headings.filter((h) => h.depth === 2);

// 構造化データ
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  ...(post.data.heroImage
    ? { image: new URL(post.data.heroImage, Astro.site).toString() }
    : {}),
  author: { '@type': 'Organization', name: 'よるじかん' },
  publisher: { '@type': 'Organization', name: 'よるじかん' },
  mainEntityOfPage: pageURL,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'ホーム',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: post.data.title,
      item: pageURL,
    },
  ],
};
const faqJsonLd = post.data.faq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;

// 関連記事: タグが重なる記事を優先し、次に新しい順で最大3件
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const myTags = new Set(post.data.tags);
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => myTags.has(t)).length,
  }))
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime(),
  )
  .slice(0, 3)
  .map(({ post: p }) => p);
---

<Base title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <nav class="breadcrumb" aria-label="パンくずリスト">
    <ol>
      <li><a href="/">ホーム</a></li>
      <li aria-current="page">{post.data.title}</li>
    </ol>
  </nav>

  <article>
    <h1>{post.data.title}</h1>
    <aside class="pr-note">
      この記事にはアフィリエイトリンクが含まれます。リンク先で商品を購入いただくと、
      サイト運営の支えになります（価格が変わることはありません）。
    </aside>
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>
        公開: {formatDate(post.data.pubDate)}
      </time>
      {post.data.updatedDate && (
        <time datetime={post.data.updatedDate.toISOString()}>
          更新: {formatDate(post.data.updatedDate)}
        </time>
      )}
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    {post.data.heroImage && (
      <img class="hero-image" src={post.data.heroImage} alt={post.data.title} />
    )}
    {tocHeadings.length > 0 && (
      <nav class="toc" aria-label="目次">
        <p class="toc-title">もくじ</p>
        <ol class="toc-list">
          {tocHeadings.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}
    <Content />
  </article>

  <section class="author-box">
    <p class="author-name">よるじかん編集部</p>
    <p class="author-text">
      夜のセルフケアと快眠道具を調べるのが好きな個人運営ブログです。
      実際に使ったもの・調べたものを、よい点も気になる点も含めて正直にまとめています。
    </p>
    <p class="author-link"><a href="/about/">このブログについて →</a></p>
  </section>

  {related.length > 0 && (
    <section class="related">
      <h2 class="related-title">関連記事</h2>
      <ul class="related-list">
        {related.map((p) => (
          <li class="related-card">
            <a href={`/blog/${p.id}/`} class="related-thumb" aria-hidden="true" tabindex="-1">
              {p.data.heroImage ? (
                <img src={p.data.heroImage} alt="" loading="lazy" />
              ) : (
                <span class="related-thumb-empty">☾</span>
              )}
            </a>
            <div class="related-body">
              <a href={`/blog/${p.id}/`} class="related-link">{p.data.title}</a>
              <div class="related-meta">
                <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="back"><a href="/">← 記事一覧へ戻る</a></p>
  <style>
    /* ---------- パンくず ---------- */
    .breadcrumb { margin: 0 0 20px; }
    .breadcrumb ol {
      list-style: none; display: flex; flex-wrap: wrap; gap: 6px;
      margin: 0; padding: 0; font-size: 0.82rem; color: var(--muted);
    }
    .breadcrumb li { display: inline-flex; align-items: center; gap: 6px; }
    .breadcrumb li + li::before { content: "＞"; color: var(--accent); font-size: 0.72rem; }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--accent); }

    /* ---------- PR表記 ---------- */
    .pr-note {
      margin: 14px 0 0;
      padding: 10px 14px;
      font-size: 0.8rem;
      line-height: 1.7;
      color: var(--muted);
      background: var(--surface);
      border: 1px dashed var(--border);
      border-radius: 10px;
    }

    .post-meta { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 0.85rem; margin: 14px 0 26px; flex-wrap: wrap; }
    .hero-image {
      width: 100%; height: auto; display: block;
      border-radius: var(--radius);
      margin: 0 0 30px;
    }
    .back { margin-top: 44px; }
    article h1 { font-size: 1.62rem; line-height: 1.55; margin: 0; }

    /* ---------- 目次 ---------- */
    .toc {
      margin: 0 0 34px;
      padding: 18px 22px 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      border-radius: 10px;
    }
    .toc-title {
      font-family: "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Yu Mincho", "YuMincho", serif;
      font-size: 1.02rem; font-weight: 600; margin: 0 0 8px; color: var(--accent);
      letter-spacing: 0.06em;
    }
    .toc-list { margin: 0; padding-left: 1.35em; }
    .toc-list li { margin: 0.3em 0; }
    .toc-list li::marker { color: var(--accent); }
    .toc-list a { color: var(--text); text-decoration: none; }
    .toc-list a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    /* ---------- 著者プロフィール ---------- */
    .author-box {
      margin-top: 52px;
      padding: 22px 24px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .author-name {
      font-family: "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Yu Mincho", "YuMincho", serif;
      font-size: 1.05rem; font-weight: 600; margin: 0 0 8px;
      display: flex; align-items: center; gap: 8px;
    }
    .author-name::before { content: "☾"; color: var(--accent); font-size: 1.3rem; line-height: 1; }
    .author-text { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.85; }
    .author-link { margin: 10px 0 0; font-size: 0.9rem; }
    .author-link a { text-decoration: none; }
    .author-link a:hover { text-decoration: underline; text-underline-offset: 3px; }

    .related { margin-top: 56px; }
    .related-title {
      font-family: "Hiragino Mincho ProN", "Hiragino Mincho Pro", "Yu Mincho", "YuMincho", serif;
      font-size: 1.25rem; font-weight: 600;
      margin: 0 0 18px; padding-bottom: 0.4em;
      border-bottom: 1px solid var(--border);
    }
    .related-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
    .related-card {
      display: flex; gap: 16px; align-items: stretch;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: background 0.2s ease;
    }
    .related-card:hover { background: var(--card-hover); }
    .related-thumb { flex: 0 0 148px; display: block; background: #232c4c; }
    .related-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .related-thumb-empty {
      width: 100%; height: 100%; min-height: 84px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; color: var(--accent);
      background: linear-gradient(135deg, #1c2547 0%, #2a3355 55%, #3a4570 100%);
    }
    .related-body { padding: 12px 16px 12px 0; display: flex; flex-direction: column; justify-content: center; gap: 6px; }
    .related-link { color: var(--text); font-weight: 700; font-size: 0.98rem; line-height: 1.6; text-decoration: none; }
    .related-link:hover { color: var(--accent); }
    .related-meta { color: var(--muted); font-size: 0.8rem; }
    @media (max-width: 640px) {
      article h1 { font-size: 1.4rem; }
      .toc { padding: 14px 16px 10px; }
      .author-box { padding: 18px 16px; }
      .related-thumb { flex-basis: 104px; }
      .related-body { padding: 10px 12px 10px 0; }
    }
  </style>
</Base>
