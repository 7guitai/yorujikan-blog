---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const formatDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

// 目次: h2/h3 からネスト構造を生成（本文内TOC用）
interface TocItem {
  text: string;
  slug: string;
  children: { text: string; slug: string }[];
}
const tocItems: TocItem[] = [];
for (const h of headings) {
  if (h.depth === 2) {
    tocItems.push({ text: h.text, slug: h.slug, children: [] });
  } else if (h.depth === 3 && tocItems.length > 0) {
    tocItems[tocItems.length - 1].children.push({ text: h.text, slug: h.slug });
  }
}
// サイドバー目次用（h2のみ、Base経由でSidebarへ）
const sidebarToc = headings.filter((h) => h.depth === 2);

// 構造化データ
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  ...(post.data.heroImage
    ? { image: new URL(post.data.heroImage, Astro.site).toString() }
    : {}),
  author: { '@type': 'Organization', name: 'よるじかん' },
  publisher: { '@type': 'Organization', name: 'よるじかん' },
  mainEntityOfPage: pageURL,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'ホーム',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: post.data.title,
      item: pageURL,
    },
  ],
};
const faqJsonLd = post.data.faq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// 前後記事（公開日昇順で隣り合う記事）
const byDateAsc = [...allPosts].sort(
  (a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime(),
);
const myIndex = byDateAsc.findIndex((p) => p.id === post.id);
const prevPost = myIndex > 0 ? byDateAsc[myIndex - 1] : null;
const nextPost =
  myIndex >= 0 && myIndex < byDateAsc.length - 1 ? byDateAsc[myIndex + 1] : null;

// 関連記事: タグが重なる記事を優先し、次に新しい順で最大4件
const myTags = new Set(post.data.tags);
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => myTags.has(t)).length,
  }))
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime(),
  )
  .slice(0, 4)
  .map(({ post: p }) => p);

const firstTag = post.data.tags[0];
---

<Base title={post.data.title} description={post.data.description} toc={sidebarToc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <Fragment slot="breadcrumb">
    <li><a href="/">ホーム</a></li>
    <li aria-current="page">{post.data.title}</li>
  </Fragment>

  <article class="post">
    <header class="post-head">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        {firstTag && (
          <a class="cat-label" href={`/tags/${firstTag}/`}>{firstTag}</a>
        )}
        <time class="date" datetime={post.data.pubDate.toISOString()}>
          <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0-18zm0 4v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <time class="date" datetime={post.data.updatedDate.toISOString()}>
            更新: {formatDate(post.data.updatedDate)}
          </time>
        )}
      </div>
      {post.data.heroImage && (
        <div class="eyecatch">
          <img src={post.data.heroImage} alt={post.data.title} />
        </div>
      )}
    </header>

    <div class="post-content">
      <div class="pr-note">
        <strong>📢 PR：</strong>この記事にはアフィリエイトリンクが含まれます。リンク先で商品を購入いただくと、サイト運営の支えになります（価格が変わることはありません）。
      </div>

      {tocItems.length > 0 && (
        <div class="toc" id="toc">
          <div class="toc__head">
            <span>目次</span>
            <button class="toc__toggle" id="tocToggle" type="button">閉じる</button>
          </div>
          <ol class="toc__list" id="tocList">
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.slug}`}>{item.text}</a>
                {item.children.length > 0 && (
                  <ol>
                    {item.children.map((child) => (
                      <li><a href={`#${child.slug}`}>{child.text}</a></li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </div>
      )}

      <Content />
    </div>

    <div class="share">
      <p class="share__title">よかったらシェアしてね！</p>
      <ul class="share__list">
        <li><a href="#" class="sns sns--x" data-share="x">X</a></li>
        <li><a href="#" class="sns sns--fb" data-share="fb">f</a></li>
        <li><a href="#" class="sns sns--hb" data-share="hb">B!</a></li>
        <li><a href="#" class="sns sns--line" data-share="line">LINE</a></li>
        <li><button class="sns sns--copy" id="copyBtn" type="button">URL</button></li>
      </ul>
      <p class="share__copied" id="copied">URLをコピーしました！</p>
    </div>

    {(prevPost || nextPost) && (
      <nav class="pn-links">
        {prevPost ? (
          <a href={`/blog/${prevPost.id}/`} class="pn pn--prev">
            <span>前の記事</span>
            {prevPost.data.title}
          </a>
        ) : (
          <span></span>
        )}
        {nextPost ? (
          <a href={`/blog/${nextPost.id}/`} class="pn pn--next">
            <span>次の記事</span>
            {nextPost.data.title}
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    )}

    <section class="author">
      <h2 class="section-title">この記事を書いた人</h2>
      <div class="author__inner">
        <div class="avatar avatar--lg">☾</div>
        <div>
          <p class="author__name">よるじかん編集部</p>
          <p class="author__desc">
            夜のセルフケアと快眠道具を調べるのが好きな個人運営ブログです。実際に使ったもの・調べたものを、よい点も気になる点も含めて正直にまとめています。
          </p>
          <p class="author__desc"><a href="/about/">このブログについて →</a></p>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="related">
        <h2 class="section-title">関連記事</h2>
        <ul class="card-list">
          {related.map((p, i) => (
            <li>
              <a href={`/blog/${p.id}/`}>
                <div class={`card-thumb c${(i % 4) + 1}`}>
                  {p.data.heroImage && (
                    <img src={p.data.heroImage} alt="" loading="lazy" />
                  )}
                </div>
                <p>{p.data.title}</p>
                <time datetime={p.data.pubDate.toISOString()}>
                  {formatDate(p.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
