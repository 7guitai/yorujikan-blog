font-size: 1.15rem;
font-weight: 700;
}
.nap-out.t {
font-size: 1.5rem;
font-weight: 800;
cursor: pointer;
}
</style>

<script>
const CYCLE = 90;
const LS = { wake: 'sc_wake', bed: 'sc_bed', lat: 'sc_lat'};
let latency = 15;

const $ = (id) => document.getElementById(id);
const wakeInput = $('wakeTime');
const bedInput = $('bedTime');

function toMin(t) {
const [h, m] = String(t || '').split(':').map(Number);
return (isNaN(h)? 0: h) * 60 + (isNaN(m)? 0: m);
}
function fmt(min) {
const v = ((min % 1440) + 1440) % 1440;
return String(Math.floor(v / 60)).padStart(2, '0') + ':' + String(v % 60).padStart(2, '0');
}
function sleepLabel(cycles) {
const total = cycles * CYCLE;
return '睡眠 約' + Math.floor(total / 60) + '時間' + (total % 60? (total % 60) + '分': '');
}
const CYCLE_META = {
6: { badge: 'しっかり休みたい日に', action: 'に布団へ', wakeAction: 'に起床'},
5: { badge: '迷ったらこれ', action: 'に布団へ', wakeAction: 'に起床'},
4: { badge: '忙しい日の目安', action: 'に布団へ', wakeAction: 'に起床'},
};

function cardHTML(c, timeMin, dayLabel, actionText, isPast) {
const meta = CYCLE_META[c];
const cls = 'scard' + (c === 5? ' rec': '') + (isPast? ' past': '');
return '<div class="' + cls + '">' +
'<span class="badge">' + meta.badge + '</span>' +
'<div class="t" data-copy="' + fmt(timeMin) + '" title="タップでコピー">' + fmt(timeMin) + '頃' +
(dayLabel? '<span class="day">' + dayLabel + '</span>': '') + '</div>' +
'<div class="meta">' + sleepLabel(c) + '（90分×' + c + 'サイクル＋入眠' + latency + '分）' + actionText + '</div>' +
'</div>';
}

function renderBed() {
const wake = toMin(wakeInput.value || '07:00');
const now = new Date();
const nowMin = now.getHours() * 60 + now.getMinutes();
// 起床時刻の直近の到来を「その朝」とみなし、就寝候補が過去かどうか判定する
const wakeToday = nowMin < wake;
let html = '<div class="cards">';
let allRecPast = true;
[4, 5, 6].forEach((c) => {
const bed = wake - c * CYCLE - latency;
const bedNorm = ((bed % 1440) + 1440) % 1440;
// 就寝が起床より手前（前日夜）か、当日未明か
const dayLabel = bedNorm >= wake? '前日': (bedNorm < 720? '当日未明': '前日');
// 過去判定：起床が今日の場合は前日夜の候補はすべて過去扱いにしない（今夜の話として扱う）
// 起床が明日（現在時刻が起床を過ぎている）場合、前日＝今日の夜なので、現在時刻より前なら過去
let isPast = false;
if (!wakeToday) {
isPast = bedNorm < nowMin && bedNorm >= 720;
} else {
isPast = bedNorm < nowMin && bedNorm < 720;
}
if ((c === 5 || c === 6) &&!isPast) allRecPast = false;
html += cardHTML(c, bed, dayLabel, ' に布団に入る目安', isPast);
});
html += '</div>';
if (allRecPast) {
html += '<p class="past-note">おすすめの時刻は過ぎているようです。サイクルにこだわりすぎず、できるだけ早めに布団に入って休みましょう。</p>';
}
html += '<p class="copy-hint">時刻をタップするとコピーできます。アラームはスマホ標準の時計アプリで設定してください。</p>';
$('bedResult').innerHTML = html;
document.querySelectorAll('.preset').forEach((b) => {
b.classList.toggle('active', b.dataset.wake === wakeInput.value);
});
}

function wakeCardsHTML(bedMin) {
let html = '<div class="cards">';
[4, 5, 6].forEach((c) => {
const wake = bedMin + latency + c * CYCLE;
const wakeNorm = ((wake % 1440) + 1440) % 1440;
const dayLabel = wake >= 1440? '翌日': '';
html += cardHTML(c, wakeNorm, dayLabel, ' に起きる目安', false);
});
html += '</div>';
html += '<p class="copy-hint">時刻をタップするとコピーできます。アラームはスマホ標準の時計アプリで設定してください。</p>';
return html;
}

function renderWake() {
const bed = toMin(bedInput.value || '23:30');
$('wakeResult').innerHTML = wakeCardsHTML(bed);
}

function renderAll() {
renderBed();
renderWake();
}

function save() {
try {
localStorage.setItem(LS.wake, wakeInput.value);
localStorage.setItem(LS.bed, bedInput.value);
localStorage.setItem(LS.lat, String(latency));
} catch (e) { /* 保存できない環境ではそのまま使う */}
}

// 入眠時間のピル
const pills = document.querySelectorAll('#latencyGroup.pill');
function syncPills() {
pills.forEach((p) => p.classList.toggle('active', Number(p.dataset.lat) === latency));
}
pills.forEach((p) => {
p.addEventListener('click', () => {
latency = Number(p.dataset.lat);
syncPills();
save();
renderAll();
});
});

// プリセット
document.querySelectorAll('.preset').forEach((b) => {
b.addEventListener('click', () => {
wakeInput.value = b.dataset.wake;
save();
renderBed();
});
});

// 入力変更で自動計算
wakeInput.addEventListener('input', () => { save(); renderBed();});
wakeInput.addEventListener('change', () => { save(); renderBed();});
bedInput.addEventListener('input', () => { save(); renderWake();});
bedInput.addEventListener('change', () => { save(); renderWake();});

// 今すぐ寝る
$('sleepNow').addEventListener('click', () => {
const now = new Date();
const cur = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
bedInput.value = cur;
save();
renderWake();
$('nowResult').innerHTML = '<p class="nap-out">いま（' + cur + '）布団に入る場合の起床候補</p>' + wakeCardsHTML(toMin(cur));
$('nowResult').scrollIntoView({ behavior: 'smooth', block: 'nearest'});
});

// 昼寝モード
document.querySelectorAll('.nap-btn').forEach((b) => {
b.addEventListener('click', () => {
const nap = Number(b.dataset.nap);
const now = new Date();
const start = now.getHours() * 60 + now.getMinutes();
const wake = start + latency + nap;
const wakeNorm = ((wake % 1440) + 1440) % 1440;
$('napResult').innerHTML =
'<p class="nap-out">' + nap + '分の仮眠なら、起きる目安は <span class="t" data-copy="' + fmt(wakeNorm) + '" title="タップでコピー">' + fmt(wakeNorm) + '頃</span> です</p>' +
'<p class="copy-hint">（入眠' + latency + '分を含みます）時刻をタップするとコピーできます。</p>';
});
});

// 時刻タップでコピー
document.querySelectorAll('.tool-result').forEach((box) => {
box.addEventListener('click', (e) => {
const t = e.target.closest('[data-copy]');
if (!t) return;
const text = t.dataset.copy;
const done = () => {
const orig = t.innerHTML;
t.innerHTML = 'コピーしました ✓';
setTimeout(() => { t.innerHTML = orig;}, 1200);
};
if (navigator.clipboard && navigator.clipboard.writeText) {
navigator.clipboard.writeText(text).then(done).catch(done);
} else {
done();
}
});
});

// 初期化：保存値の復元→描画
try {
const w = localStorage.getItem(LS.wake);
const b = localStorage.getItem(LS.bed);
const l = localStorage.getItem(LS.lat);
if (w) wakeInput.value = w;
if (b) bedInput.value = b;
if (l && [10, 15, 20, 30].includes(Number(l))) latency = Number(l);
} catch (e) { /* そのまま初期値で使う */}
syncPills();
renderAll();
</script>
