---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
const formatDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---

<Base
  title={`タグ「${tag}」の記事一覧`}
  description={`よるじかんのタグ「${tag}」が付いた記事一覧です。寝る前のセルフケアや快眠グッズを、選び方と比較とあわせて紹介しています。`}
>
  <Fragment slot="breadcrumb">
    <li><a href="/">ホーム</a></li>
    <li aria-current="page">タグ「{tag}」</li>
  </Fragment>

  <div class="page-head">
    <h1>タグ「{tag}」の記事</h1>
    <p class="lead">全{posts.length}件の記事があります。</p>
  </div>

  <ul class="post-grid">
    {posts.map((post, i) => (
      <li class="post-card">
        <a href={`/blog/${post.id}/`} class="post-card__thumb">
          {post.data.heroImage ? (
            <img src={post.data.heroImage} alt="" loading="lazy" />
          ) : (
            <span class={`post-card__thumb-empty c${(i % 4) + 1}`}>☾</span>
          )}
        </a>
        <div class="post-card__body">
          <div class="post-card__meta">
            {post.data.tags[0] && (
              <span class="cat-label">{post.data.tags[0]}</span>
            )}
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          <a href={`/blog/${post.id}/`} class="post-card__title">{post.data.title}</a>
          <p class="post-card__desc">{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>

  <p class="back"><a href="/">← 記事一覧へ戻る</a></p>
  <style>
    .page-head {
      background: var(--white);
      border-radius: var(--radius);
      padding: 28px 32px;
      margin-bottom: 28px;
    }
    .page-head h1 { font-size: 24px; margin: 0 0 8px; line-height: 1.5; }
    .lead { color: #555; margin: 0; font-size: 15px; }
    .back { margin-top: 36px; font-size: 14px; }

    .post-grid {
      list-style: none; padding: 0; margin: 0;
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
    }
    .post-card {
      background: var(--white); border-radius: var(--radius); overflow: hidden;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .06); display: flex; flex-direction: column;
      transition: .2s;
    }
    .post-card:hover { box-shadow: 0 4px 14px rgba(0, 0, 0, .1); }
    .post-card__thumb { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--main-light); }
    .post-card__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: .2s; }
    .post-card:hover .post-card__thumb img { opacity: .88; }
    .post-card__thumb-empty {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 2.4rem; color: #fff;
    }
    .post-card__body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; }
    .post-card__meta { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--text-sub); flex-wrap: wrap; }
    .post-card__title { font-size: 15.5px; font-weight: 700; line-height: 1.55; color: var(--text); }
    .post-card__title:hover { color: var(--main); opacity: 1; }
    .post-card__desc {
      margin: 0; font-size: 13px; color: #555; line-height: 1.75;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    @media (max-width: 700px) {
      .post-grid { grid-template-columns: 1fr; }
      .page-head { padding: 22px 18px; }
    }
  </style>
</Base>
