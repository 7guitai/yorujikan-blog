---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
const formatDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---

<Base
  title={`タグ「${tag}」の記事一覧`}
  description={`よるじかんのタグ「${tag}」が付いた記事一覧です。寝る前のセルフケアや快眠グッズを、選び方と比較とあわせて紹介しています。`}
>
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <ol>
      <li><a href="/">ホーム</a></li>
      <li aria-current="page">タグ「{tag}」</li>
    </ol>
  </nav>

  <h1>タグ「{tag}」の記事</h1>
  <p class="lead">全{posts.length}件の記事があります。</p>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a href={`/blog/${post.id}/`} class="post-thumb" aria-hidden="true" tabindex="-1">
          {post.data.heroImage ? (
            <img src={post.data.heroImage} alt="" loading="lazy" />
          ) : (
            <span class="post-thumb-empty">☾</span>
          )}
        </a>
        <div class="post-body">
          <a href={`/blog/${post.id}/`} class="post-title">{post.data.title}</a>
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <p class="post-desc">{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>

  <p class="back"><a href="/">← 記事一覧へ戻る</a></p>
  <style>
    .breadcrumb { margin: 0 0 20px; }
    .breadcrumb ol {
      list-style: none; display: flex; flex-wrap: wrap; gap: 6px;
      margin: 0; padding: 0; font-size: 0.82rem; color: var(--muted);
    }
    .breadcrumb li { display: inline-flex; align-items: center; gap: 6px; }
    .breadcrumb li + li::before { content: "＞"; color: var(--accent); font-size: 0.72rem; }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--accent); }
    .lead { color: var(--muted); margin: 0 0 28px; }
    .back { margin-top: 44px; }
    .post-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 22px; }
    .post-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .post-card:hover { background: var(--card-hover); transform: translateY(-2px); }
    .post-thumb { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #232c4c; }
    .post-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .post-thumb-empty {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.6rem; color: var(--accent);
      background: linear-gradient(135deg, #1c2547 0%, #2a3355 55%, #3a4570 100%);
    }
    .post-body { padding: 18px 22px 20px; }
    .post-title {
      font-size: 1.12rem; font-weight: 700; line-height: 1.6;
      color: var(--text); text-decoration: none;
    }
    .post-title:hover { color: var(--accent); }
    .post-meta { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 0.82rem; margin-top: 8px; flex-wrap: wrap; }
    .post-desc { margin: 10px 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.75; }
    @media (max-width: 640px) {
      .post-body { padding: 15px 16px 17px; }
    }
  </style>
</Base>
